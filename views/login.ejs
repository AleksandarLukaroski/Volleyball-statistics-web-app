<!DOCTYPE html>
<html lang="en">
    <%- include("./partials/header"); %>
    <body>
        <%- include("./partials/navigation bar"); %>
        <main>
            <div class="container">
                <div class="card card-login">
                    <h2 class="card__title">Login</h2>
                    <%- include("./partials/messages"); %>
                    <form action="/users/login" method="post">
                        <label for="email">Email</label><br />
                        <input
                            type="email"
                            name="email"
                            id="email"
                            value="<%= typeof email != 'undefined' ? email : '' %>"
                        /><br />
                        <label for="password">Password</label><br />
                        <input
                            type="password"
                            name="password"
                            id="password"
                            value="<%= typeof password != 'undefined' ? password : '' %>"
                        /><br />
                        <button class="btnPrimary" type="submit">Log in</button>
                        <p class="register-paragraph">
                            Don't have an account, yet?
                            <a href="/users/register"> Register here</a>
                        </p>
                    </form>
                    <hr />
                    <a class="btnSecondary" href="#"
                        ><img
                            src="../media/Icons svg/Icon awesome-google.svg"
                            alt="Google icon"
                            class="google-icon"
                        />
                        Login with Google</a
                    >
                    <a class="btnSecondary" href="#"
                        ><img
                            src="../media/Icons svg/Icon awesome-twitter-square.svg"
                            alt="Twitter icon"
                            class="twitter-icon"
                        />Login with Twitter</a
                    >
                    <a class="btnSecondary" href="#"
                        ><img
                            src="../media/Icons svg/Icon metro-facebook.svg"
                            alt="Facebook icon"
                            class="facebook-icon"
                        />Login with Facebook</a
                    >
                </div>
            </div>
        </main>
        <%- include("./partials/footer"); %>
    </body>
</html>
