<!DOCTYPE html>
<html lang="en">
    <%- include("./partials/header"); %>
    <body>
        <%- include("./partials/navigation bar"); %>
        <main>
            <div class="container dashboard">
                <div class="dashboard__column">
                    <%- include("./partials/messages"); %>
                    <br />
                    <div class="card current-result-card">
                        <h2>Current result</h2>
                        <div class="current-result-card__content">
                            <div class="current-result-card__result-board">
                                <div
                                    class="current-result-card__result-board-teams"
                                >
                                    <p><%= teamName[0] %></p>
                                    <p><%= teamName[1] %></p>
                                </div>
                                <div class="game-card__result">
                                    <div class="game-card__set">
                                        <% if(resultInSets[0] >
                                        resultInSets[1]){ %>
                                        <div class="game-card__set--winner">
                                            <%= resultInSets[0] %>
                                        </div>
                                        <div><%= resultInSets[1] %></div>
                                        <% } else if(resultInSets[1] >
                                        resultInSets[0]){ %>
                                        <div><%= resultInSets[0] %></div>
                                        <div class="game-card__set--winner">
                                            <%= resultInSets[1] %>
                                        </div>
                                        <% } else { %>
                                        <div><%= resultInSets[0] %></div>
                                        <div><%= resultInSets[1] %></div>
                                        <% } %>
                                    </div>
                                    <div class="game-card__set">
                                        <% if(previousPointWonByTeam ==
                                        teamId[0]){ %>
                                        <div class="game-card__set--winner">
                                            <%= currentSetResult[0] %>
                                        </div>
                                        <div><%= currentSetResult[1] %></div>
                                        <% } else{ %>
                                        <div><%= currentSetResult[0] %></div>
                                        <div class="game-card__set--winner">
                                            <%= currentSetResult[1] %>
                                        </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <div class="current-result-card__additional-info">
                                <p>
                                    Current set:
                                    <span
                                        ><%= (parseInt(resultInSets[0]) +
                                        parseInt(resultInSets[1])) +1 %></span
                                    >
                                </p>
                                <p>Set duration: <span>20min</span></p>
                                <p>Game duration: <span>1h 20min</span></p>
                            </div>
                        </div>
                    </div>
