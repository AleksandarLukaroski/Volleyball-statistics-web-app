                            <h2>Add new point</h2>
                            <!-- <h2>Game ID is: <%= gameAttributes[7] %></h2> -->
                            <div class="label-input">
                                <label for="addNewPointTeam">Team</label><br />
                                <select name="teamIndex" id="addNewPointTeam">
                                    <option value="0">
                                        <%= teamName[0] %>
                                    </option>
                                    <option value="1">
                                        <%= teamName[1] %>
                                    </option>
                                </select>
                            </div>
                            <div class="label-input">
                                <label for="typeOfPoint">Type of point</label
                                ><br />
                                <select name="typeOfPoint">
                                    <option value="Attack">Attack</option>
                                    <option value="Block">Block</option>
                                    <option value="Block out">Block out</option>
                                    <option value="Ace">Ace</option>
                                    <option value="Error">Error</option>
                                </select>
                            </div>
                            <div class="label-input">
                                <label>Player</label><br />
                                <select
                                    name="player"
                                    id="addNewPointFirstTeamPlayers"
                                >
                                    <% for (let i = 0; i < 6; i++){ %>
                                    <option
                                        value="<%= firstTeamCourtPosition[i] %>"
                                    >
                                        <%=
                                        firstTeamPlayerFirstName[firstTeamPlayerId.indexOf(firstTeamCourtPosition[i])]
                                        %> <%=
                                        firstTeamPlayerLastName[firstTeamPlayerId.indexOf(firstTeamCourtPosition[i])]
                                        %>, <%=
                                        firstTeamPlayerJersey[firstTeamPlayerId.indexOf(firstTeamCourtPosition[i])]
                                        %>, <%=
                                        firstTeamPlayerPosition[firstTeamPlayerId.indexOf(firstTeamCourtPosition[i])]
                                        %>
                                    </option>
                                    <% } %>
                                </select>
                                <select
                                    name="player"
                                    id="addNewPointSecondTeamPlayers"
                                    class="hide"
                                >
                                    <% for (let i = 0; i < 6; i++){ %>
                                    <option
                                        value="<%= secondTeamCourtPosition[i] %>"
                                    >
                                        <%=
                                        secondTeamPlayerFirstName[secondTeamPlayerId.indexOf(secondTeamCourtPosition[i])]
                                        %> <%=
                                        secondTeamPlayerLastName[secondTeamPlayerId.indexOf(secondTeamCourtPosition[i])]
                                        %>, <%=
                                        secondTeamPlayerJersey[secondTeamPlayerId.indexOf(secondTeamCourtPosition[i])]
                                        %>, <%=
                                        secondTeamPlayerPosition[secondTeamPlayerId.indexOf(secondTeamCourtPosition[i])]
                                        %>
                                    </option>
                                    <% } %>
                                </select>
                            </div>
                            <button class="btnPrimary" type="submit">
                                Add point
                            </button>
                        </form>
                    </div>
