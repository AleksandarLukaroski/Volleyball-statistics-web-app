                                type="hidden"
                                name="formNumber"
                                value="<%= formNumber %>"
                            />
                            <input
                                type="hidden"
                                name="numberOfPlayers"
                                value="<%= numberOfPlayers %>"
                            />
                            <% for (let i = 0; i < 2; i++){ %>
                            <input
                                type="hidden"
                                name="teamName"
                                value="<%= teamName[i] %>"
                            />
                            <input
                                type="hidden"
                                name="teamId"
