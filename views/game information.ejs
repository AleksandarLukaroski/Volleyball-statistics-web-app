<!DOCTYPE html>
<html lang="en">
    <%- include("./partials/header"); %>
    <body>
        <%- include("./partials/navigation bar"); %>
        <main>
            <div class="container">
                <div class="card card-add-new-game">
                    <div class="top-of-form">
                        <span class="btnSecondary">1/5</span>
                        <h2 class="card__title">Game information</h2>
                    </div>
                    <%- include("./partials/messages"); %>
                    <form
                        class="form-add-new-game"
                        action="/addnewgame/gameinformation"
                        method="post"
                    >
                        <input type="hidden" name="formNumber" value="1" />
                        <input type="hidden" name="numberOfPlayers" value="8" />
                        <div class="label-input">
                            <label for="firstTeam">First team</label><br />
                            <input
                                type="text"
                                name="teamName"
                                id="firstTeam"
                                value="<%= typeof teamName != 'undefined' ? teamName[0] : '' %>"
                            /><br />
                        </div>
                        <div class="label-input">
                            <label for="secondTeam">Second team</label><br />
                            <input
                                type="text"
                                name="teamName"
                                id="secondTeam"
                                value="<%= typeof teamName != 'undefined' ? teamName[1] : '' %>"
                            /><br />
                        </div>
                        <div class="label-input">
                            <label for="league">League</label><br />
                            <input
                                type="text"
                                name="gameAttributes"
                                id="league"
                                value="<%= typeof gameAttributes != 'undefined' ? gameAttributes[0] : '' %>"
                            /><br />
                        </div>
                        <div class="label-input">
                            <label for="cityCountry">City and country</label
                            ><br />
                            <input
                                type="text"
                                name="gameAttributes"
                                id="cityCountry"
                                value="<%= typeof gameAttributes != 'undefined' ? gameAttributes[1] : '' %>"
                            /><br />
                        </div>
                        <div class="label-input">
                            <label for="hall">Hall</label><br />
                            <input
                                type="text"
                                name="gameAttributes"
                                id="hall"
                                value="<%= typeof gameAttributes != 'undefined' ? gameAttributes[2] : '' %>"
                            /><br />
                        </div>
                        <br />
                        <div class="label-input">
                            <label for="firstReferee">First referee</label
                            ><br />
                            <input
                                type="text"
                                name="gameAttributes"
                                id="firstReferee"
                                value="<%= typeof gameAttributes != 'undefined' ? gameAttributes[3] : '' %>"
                                league
                            /><br />
                        </div>
                        <div class="label-input">
                            <label for="secondReferee">Second referee</label
                            ><br />
                            <input
                                type="text"
                                name="gameAttributes"
                                id="secondReferee"
                                value="<%= typeof gameAttributes != 'undefined' ? gameAttributes[4] : '' %>"
                                league
                            /><br />
                        </div>
                        <div class="label-input">
                            <label for="gameDescription">Game description</label
                            ><br />
                            <textarea
                                name="gameAttributes"
                                rows="10"
                            ></textarea>
                        </div>
                        <div class="label-input">
                            <label for="gamePrivacy"
                                >Game privacy
                                <span
                                    >(Make this game visible to others?)</span
                                ></label
                            ><br />
                            <select name="gameAttributes">
                                <option value="private">Private</option>
                                <option value="public">Public</option>
                            </select>
                        </div>
                        <button class="btnPrimary" type="submit">Next</button>
                    </form>
                </div>
            </div>
