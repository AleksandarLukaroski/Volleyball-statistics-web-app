<% if(typeof errors != 'undefined'){ %> <% errors.forEach(function(error) { %>
<div class="alert-div">
    <p class="alert-div__message alert-div__message--error">
        *<%= error.msg %>
    </p>
</div>
<% }); %> <% } %> <% if(success_msg != ''){ %>
<div class="alert-div">
    <p class="alert-div__message alert-div__message--success">
        *<%= success_msg %>
    </p>
</div>
<% } %> <% if(error_msg != ''){ %>
<div class="alert-div">
    <p class="alert-div__message alert-div__message--error">
        *<%= error_msg %>
    </p>
</div>
<% } %> <% if(error != ''){ %>
<div class="alert-div">
    <p class="alert-div__message alert-div__message--error">*<%= error %></p>
</div>
<% } %>
